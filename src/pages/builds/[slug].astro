---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { entryPath, getPublished } from "../../lib/content";

export const getStaticPaths = (async () => {
    const entries = await getPublished("builds");
    return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { cover, coverAlt } = entry.data;
---

<ArticleLayout kind="build" href={entryPath(entry)} {...entry.data}>
    {cover && (
        <figure slot="media" class="cover">
            <Image src={cover} alt={coverAlt ?? ""} widths={[640, 960, 1280]} sizes="(max-width: 1000px) 100vw, 960px" />
        </figure>
    )}
    <Content />
</ArticleLayout>

<style>
    .cover {
        margin: 0 0 40px;
    }
    .cover :global(img) {
        display: block;
        width: 100%;
        max-width: 960px;
        height: auto;
    }
</style>
