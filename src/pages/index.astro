---
import BaseLayout from "../layouts/BaseLayout.astro";
import Entry from "../components/Entry.astro";

const name: string = "Dimitri";
---

<BaseLayout title="Dimitri">
    <div class="page">
        <header>
            <h1>{name}</h1>
            <p class="lead">Contents: everything I write, film and build, newest first.</p>
        </header>

        <ol class="entries">
            <Entry
                    kind="build"
                    title="This site, in Astro"
                    month="Nov"
                    href="/about"
                    note="Rebuilt from scratch to relearn web development."
            />
            <Entry kind="writing" title="Notes on deep work" month="Feb" href="/about" />
            <Entry kind="film" title="[First short film]" month="May" href="/about" />
        </ol>
    </div>
</BaseLayout>

<style>
    .page {
        max-width: 1160px;
        margin: 0 auto;
        padding: 56px 40px 96px;
    }
    h1 {
        margin: 0;
        font-size: var(--text-name);
        font-weight: 300;
        line-height: 1;
        letter-spacing: -0.02em;
    }
    .lead {
        margin: 14px 0 0;
        font-size: var(--text-lead);
        font-style: italic;
        color: var(--ink-soft);
    }
    .entries {
        list-style: none;
        margin: 48px 0 0;
        padding: 0;
    }
</style>