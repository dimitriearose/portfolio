---
import BaseLayout from "../layouts/BaseLayout.astro";
import Chapter from "../components/Chapter.astro";
import KindKey from "../components/KindKey.astro";
import SiteNav from "../components/SiteNav.astro";
import { getWorkItems } from "../lib/content";
import { groupByYear } from "../lib/work";

const name: string = "Dimitri";

const chapters = groupByYear(await getWorkItems());
---

<BaseLayout title={name}>
    <header class="masthead">
        <h1>{name}</h1>
        <div class="byline">
            <p class="lead">Contents: everything I write, film and build, newest first.</p>
            <SiteNav />
        </div>
    </header>

    <KindKey />

    <main class="chapters">
        {chapters.map(({ year, items }) => <Chapter year={year} items={items} />)}
    </main>
</BaseLayout>

<style>
    h1 {
        margin: 0;
        font-size: var(--text-name);
        font-weight: 300;
        line-height: 1;
        letter-spacing: -0.02em;
    }
    .byline {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px 40px;
        margin: 14px 0 52px;
    }
    .lead {
        margin: 0;
        font-size: var(--text-lead);
        font-style: italic;
        color: var(--ink-soft);
    }
    .chapters {
        display: grid;
        gap: 56px;
        padding-top: 56px;
    }
</style>
