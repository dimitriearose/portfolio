---
import { withBase } from "../lib/url";

const links = [
    { href: withBase("/writing/"), label: "Writing" },
    { href: withBase("/films/"), label: "Films" },
    { href: withBase("/builds/"), label: "Builds" },
    { href: withBase("/about/"), label: "About" },
];
const path = Astro.url.pathname;
---

<nav aria-label="Main">
    <ul>
        {links.map(({ href, label }) => (
            <li>
                <a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>
                    {label}
                </a>
            </li>
        ))}
    </ul>
</nav>

<style>
    ul {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 22px;
        margin: 0;
        padding: 0;
        list-style: none;
    }
    a {
        text-underline-offset: 3px;
    }
    a[aria-current="page"] {
        color: var(--ink);
        text-decoration-thickness: 2px;
    }
</style>
