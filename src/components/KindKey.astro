---
import Glyph from "./Glyph.astro";
import type { Kind } from "../types";

const kinds: { kind: Kind; label: string }[] = [
    { kind: "writing", label: "Writing" },
    { kind: "film", label: "Film" },
    { kind: "build", label: "Build" },
];
---

<ul class="key" aria-label="Key to icons">
    {kinds.map(({ kind, label }) => (
        <li><Glyph kind={kind} decorative />{label}</li>
    ))}
</ul>

<style>
    .key {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 30px;
        margin: 0;
        padding: 0 0 18px;
        list-style: none;
        border-bottom: 1px solid var(--rule);
        color: var(--ink-soft);
    }
    li {
        display: flex;
        align-items: center;
        gap: 10px;
    }
</style>
