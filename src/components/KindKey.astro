---
import Glyph from "./Glyph.astro";
import type { Kind } from "../types";

const kinds: { kind: Kind; label: string }[] = [
    { kind: "writing", label: "Writing" },
    { kind: "film", label: "Film" },
    { kind: "build", label: "Build" },
];
---

<!--
    The key to the icons doubles as a filter, with no JavaScript: each item
    is a radio button, and CSS :has() fades the rows that don't match the
    checked one. "Show all" only appears while a filter is on.
-->
<fieldset class="key">
    <legend class="visually-hidden">Highlight one kind of work</legend>
    {kinds.map(({ kind, label }) => (
        <label>
            <input class="visually-hidden" type="radio" name="kind" value={kind} />
            <Glyph kind={kind} decorative />
            {label}
        </label>
    ))}
    <label class="all">
        <input class="visually-hidden" type="radio" name="kind" value="all" checked />
        Show all
    </label>
</fieldset>

<style>
    .key {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 30px;
        margin: 0;
        padding: 0 0 18px;
        border: 0;
        border-bottom: 1px solid var(--rule);
        color: var(--ink-soft);
    }
    label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        text-underline-offset: 6px;
    }
    label:hover {
        color: var(--ink);
    }
    label:has(input:checked) {
        color: var(--ink);
        text-decoration: underline 1px;
    }
    label:has(input[value="writing"]:checked) { text-decoration-color: var(--ink-writing); }
    label:has(input[value="film"]:checked) { text-decoration-color: var(--ink-film); }
    label:has(input[value="build"]:checked) { text-decoration-color: var(--ink-build); }
    label:has(input:checked) { text-decoration-thickness: 2px; }
    label:has(input:focus-visible) {
        outline: 2px solid var(--link);
        outline-offset: 4px;
        border-radius: 2px;
    }
    /* "Show all" sits at the end, hidden until a kind is chosen. */
    .all {
        margin-left: auto;
        font-style: italic;
        text-decoration: none !important;
        visibility: hidden;
    }
    .key:has(input:checked:not([value="all"])) .all {
        visibility: visible;
    }
    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
        opacity: 0;
    }
</style>

<style is:global>
    /* Fade rows (and whole years) that don't match the chosen kind. */
    .entry,
    .chapter h2 {
        transition: opacity 0.25s ease;
    }
    body:has(.key input[value="writing"]:checked) .entry:not([data-kind="writing"]),
    body:has(.key input[value="writing"]:checked) .chapter:not(:has([data-kind="writing"])) h2,
    body:has(.key input[value="film"]:checked) .entry:not([data-kind="film"]),
    body:has(.key input[value="film"]:checked) .chapter:not(:has([data-kind="film"])) h2,
    body:has(.key input[value="build"]:checked) .entry:not([data-kind="build"]),
    body:has(.key input[value="build"]:checked) .chapter:not(:has([data-kind="build"])) h2 {
        opacity: 0.2;
    }
</style>
