---
import Entry from "./Entry.astro";
import type { WorkItem } from "../types";

interface Props {
    year: number;
    items: WorkItem[];
}

const { year, items } = Astro.props;

const month = (date: Date) =>
    date.toLocaleString("en-US", { month: "short", timeZone: "UTC" });
---

<section class="chapter" aria-labelledby={`year-${year}`}>
    <h2 id={`year-${year}`}>{year}</h2>
    <ol>
        {items.map((item) => (
            <Entry
                kind={item.kind}
                title={item.title}
                month={month(item.date)}
                href={item.href}
                note={item.note}
            />
        ))}
    </ol>
</section>

<style>
    .chapter {
        display: grid;
        grid-template-columns: 11rem 1fr;
        align-items: start;
    }
    h2 {
        margin: 0;
        font-size: var(--text-year);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.01em;
        /* sit the year on the first row's baseline */
        padding-top: 4px;
    }
    ol {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    @media (max-width: 760px) {
        .chapter {
            grid-template-columns: 1fr;
            row-gap: 8px;
        }
    }
</style>
