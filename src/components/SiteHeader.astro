---
import SiteNav from "./SiteNav.astro";
---

<header class="site-header">
    <a class="name" href="/">Dimitri</a>
    <SiteNav />
</header>

<style>
    .site-header {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px 40px;
        padding-bottom: 18px;
        margin-bottom: 56px;
        border-bottom: 1px solid var(--rule);
    }
    .name {
        font-size: var(--text-entry);
        font-weight: 300;
        color: var(--ink);
        text-decoration: none;
    }
</style>
