---
import type { Kind } from "../types";

interface Props {
    kind: Kind;
    /** Set when a visible text label sits next to the icon. */
    decorative?: boolean;
}

const { kind, decorative = false } = Astro.props;

const labels: Record<Kind, string> = {
    writing: "Writing",
    film: "Film",
    build: "Build",
};
---

<svg
        class="glyph"
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        role={decorative ? undefined : "img"}
        aria-label={decorative ? undefined : labels[kind]}
        aria-hidden={decorative ? "true" : undefined}
>
    {kind === "writing" && <path d="M3 5h14M3 10h14M3 15h9" />}
    {kind === "film" && (
            <>
                <rect x="2.5" y="4.5" width="15" height="11" rx="1" />
                <path d="M6.5 4.5v11M13.5 4.5v11" />
            </>
    )}
    {kind === "build" && (
            <>
                <rect x="5.5" y="5.5" width="9" height="9" />
                <path d="M8 2v3.5M12 2v3.5M8 14.5V18M12 14.5V18M2 8h3.5M2 12h3.5M14.5 8H18M14.5 12H18" />
            </>
    )}
</svg>

<style>
    .glyph {
        flex: none;
        align-self: center;
    }
</style>