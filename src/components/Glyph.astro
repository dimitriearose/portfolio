---
import type { Kind } from "../types";

interface Props {
    kind: Kind;
    /** Set when a visible text label sits next to the icon. */
    decorative?: boolean;
}

const { kind, decorative = false } = Astro.props;

const labels: Record<Kind, string> = {
    writing: "Writing",
    film: "Film",
    build: "Build",
};
---

<svg
        class="glyph"
        data-kind={kind}
        width="20"
        height="20"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        role={decorative ? undefined : "img"}
        aria-label={decorative ? undefined : labels[kind]}
        aria-hidden={decorative ? "true" : undefined}
>
    {kind === "writing" && (
            <>
                <path class="line" pathLength="1" style="--i: 0" d="M3 5h14" />
                <path class="line" pathLength="1" style="--i: 1" d="M3 10h14" />
                <path class="line" pathLength="1" style="--i: 2" d="M3 15h9" />
            </>
    )}
    {kind === "film" && (
            <>
                <rect x="2.5" y="4.5" width="15" height="11" rx="1" />
                <path class="frame frame-out" d="M6.5 4.5v11" />
                <path class="frame" d="M13.5 4.5v11" />
                <path class="frame frame-in" d="M20.5 4.5v11" />
            </>
    )}
    {kind === "build" && (
            <>
                <rect x="5.5" y="5.5" width="9" height="9" />
                <path class="pins" style="--i: 0" d="M8 2v3.5M12 2v3.5" />
                <path class="pins" style="--i: 1" d="M14.5 8H18M14.5 12H18" />
                <path class="pins" style="--i: 2" d="M8 14.5V18M12 14.5V18" />
                <path class="pins" style="--i: 3" d="M2 8h3.5M2 12h3.5" />
            </>
    )}
</svg>

<style>
    .glyph {
        flex: none;
        align-self: center;
    }
    .glyph[data-kind="writing"] { color: var(--ink-writing); }
    .glyph[data-kind="film"] { color: var(--ink-film); }
    .glyph[data-kind="build"] { color: var(--ink-build); }

    /* The spare film frame waits just off the right edge, invisible. */
    .frame-in {
        opacity: 0;
    }

    /* Living icons: when the row (or key item) holding the icon is hovered
       or focused, the icon acts out its kind once. */
    @media (prefers-reduced-motion: no-preference) {
        /* Writing: each line is written out, one after another. */
        :global(:is(a, label):is(:hover, :focus-visible)) .line {
            stroke-dasharray: 1;
            animation: write 0.32s ease-out calc(var(--i) * 0.11s) backwards;
        }
        /* Film: the strip advances one frame, twice. */
        :global(:is(a, label):is(:hover, :focus-visible)) .frame {
            animation: advance 0.3s ease-in-out 2;
        }
        :global(:is(a, label):is(:hover, :focus-visible)) .frame-out {
            animation-name: advance, fade-out;
        }
        :global(:is(a, label):is(:hover, :focus-visible)) .frame-in {
            animation-name: advance, fade-in;
        }
        /* Build: the pins flicker round the chip, like it's powering up. */
        :global(:is(a, label):is(:hover, :focus-visible)) .pins {
            animation: flicker 0.4s ease-in-out calc(var(--i) * 0.08s);
        }
    }
    @keyframes write {
        from { stroke-dashoffset: 1; }
        to { stroke-dashoffset: 0; }
    }
    @keyframes advance {
        from { transform: translateX(0); }
        to { transform: translateX(-7px); }
    }
    @keyframes fade-out {
        from { opacity: 1; }
        60%, to { opacity: 0; }
    }
    @keyframes fade-in {
        from, 40% { opacity: 0; }
        to { opacity: 1; }
    }
    @keyframes flicker {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.15; }
    }
</style>