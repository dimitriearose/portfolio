---
import { withBase } from "../lib/url";
---

<footer>
    <p>Set in Literata. Built with Astro.</p>
    <a href={withBase("/rss.xml")}>Subscribe by RSS</a>
</footer>

<style>
    footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: baseline;
        gap: 8px 24px;
        margin-top: 48px;
        padding-top: 24px;
        border-top: 1px solid var(--rule);
        font-size: var(--text-note);
        color: var(--ink-soft);
    }
    p {
        margin: 0;
    }
    a {
        text-underline-offset: 3px;
    }
</style>
