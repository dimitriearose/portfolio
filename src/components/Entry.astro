---
import Glyph from "./Glyph.astro";
import type { Kind } from "../types";
import { titleTransitionName } from "../lib/url";

interface Props {
    kind: Kind;
    title: string;
    month: string;
    href: string;
    note?: string | undefined;
}

const { kind, title, month, href, note } = Astro.props;
---

<li class="entry">
    <a href={href}>
        <Glyph kind={kind} />
        <span class="title" style={`view-transition-name: ${titleTransitionName(href)}`}>{title}</span>
        <span class="leader" aria-hidden="true"></span>
        <span class="month">{month}</span>
    </a>
    {note && <p class="note">{note}</p>}
</li>

<style>
    /* Two columns: the line itself, and a right-hand margin for the note.
       The margin column is always reserved so months line up down the page. */
    .entry {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 13.5rem;
        column-gap: 40px;
        align-items: baseline;
        border-bottom: 1px solid var(--rule);
    }
    a {
        min-width: 0;
        display: flex;
        align-items: baseline;
        gap: 14px;
        padding: 16px 0;
        color: var(--ink);
        text-decoration: none;
    }
    a:hover .title {
        color: var(--link);
    }
    .title {
        font-size: var(--text-entry);
        line-height: 1.3;
    }
    .leader {
        flex: 1 1 40px;
        border-bottom: 2px dotted var(--leader);
        transform: translateY(-6px);
    }
    .month {
        color: var(--ink-soft);
        font-variant-numeric: oldstyle-nums;
    }
    .note {
        margin: 0;
        padding-bottom: 12px;
        font-size: var(--text-note);
        font-style: italic;
        line-height: 1.5;
        color: var(--ink-soft);
    }
    /* Narrow screens: the note drops under the line. */
    @media (max-width: 760px) {
        .entry {
            grid-template-columns: minmax(0, 1fr);
        }
        a {
            padding-bottom: 8px;
        }
        .note {
            padding: 0 0 14px 34px;
        }
    }
</style>