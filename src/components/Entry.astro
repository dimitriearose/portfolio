---
import Glyph from "./Glyph.astro";
import type { Kind } from "../types";

interface Props {
    kind: Kind;
    title: string;
    month: string;
    href: string;
    note?: string | undefined;
}

const { kind, title, month, href, note } = Astro.props;
---

<li class="entry" data-kind={kind}>
    <a href={href}>
        <Glyph kind={kind} />
        <span class="title">{title}</span>
        <span class="leader" aria-hidden="true"></span>
        <span class="month">{month}</span>
    </a>
    {note && <p class="note">{note}</p>}
</li>

<style>
    /* Two columns: the line itself, and a right-hand margin for the note.
       The margin column is always reserved so months line up down the page. */
    .entry {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 13.5rem;
        column-gap: 40px;
        align-items: baseline;
        border-bottom: 1px solid var(--rule);
    }
    a {
        min-width: 0;
        display: flex;
        align-items: baseline;
        gap: 14px;
        padding: 16px 0;
        color: var(--ink);
        text-decoration: none;
    }
    a:hover .title {
        color: var(--link);
    }
    .title {
        font-size: var(--text-entry);
        line-height: 1.3;
    }
    .leader {
        position: relative;
        flex: 1 1 40px;
        border-bottom: 2px dotted var(--leader);
        transform: translateY(-6px);
    }
    /* On hover/focus, a blue copy of the dots is revealed from the title
       towards the month, as if your eye were running along the line.
       clip-path uncovers it without stretching the dots. */
    .leader::after {
        content: "";
        position: absolute;
        inset: auto 0 -2px 0;
        border-bottom: 2px dotted var(--link);
        clip-path: inset(0 100% 0 0);
        transition: clip-path 0.45s cubic-bezier(0.3, 0.6, 0.2, 1);
    }
    a:hover .leader::after,
    a:focus-visible .leader::after {
        clip-path: inset(0 0 0 0);
    }
    a:focus-visible .title {
        color: var(--link);
    }
    .month {
        color: var(--ink-soft);
        font-variant-numeric: oldstyle-nums;
    }
    .note {
        margin: 0;
        padding-bottom: 12px;
        font-size: var(--text-note);
        font-style: italic;
        line-height: 1.5;
        color: var(--ink-soft);
    }
    /* Narrow screens: the note drops under the line. */
    @media (max-width: 760px) {
        .entry {
            grid-template-columns: minmax(0, 1fr);
        }
        a {
            padding-bottom: 8px;
        }
        .note {
            padding: 0 0 14px 34px;
        }
    }
</style>