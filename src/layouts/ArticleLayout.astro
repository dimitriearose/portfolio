---
import PageLayout from "./PageLayout.astro";
import Glyph from "../components/Glyph.astro";
import { collectionFor, sectionLabel } from "../lib/content";
import { formatMonthYear, isoDate, statusLabel } from "../lib/format";
import { withBase } from "../lib/url";
import type { Kind } from "../types";

interface Props {
    kind: Kind;
    title: string;
    date: Date;
    status?: keyof typeof statusLabel | undefined;
    description?: string | undefined;
    note?: string | undefined;
}

const { kind, title, date, status, description, note } = Astro.props;
---

<!-- An essay, film or build page: the shared page grid, with its kind,
     date and status in the left margin. -->
<PageLayout
    title={`${title} · Dimitri`}
    heading={title}
    lead={description}
    description={description ?? note}
    type="article"
>
    <Fragment slot="margin">
        <!-- The icon and label link back to the section, e.g. all films. -->
        <a class="kind" href={withBase(`/${collectionFor[kind]}/`)}>
            <Glyph kind={kind} decorative />
            {sectionLabel[kind]}
        </a>
        <time datetime={isoDate(date)}>{formatMonthYear(date)}</time>
        {status && <span class="status">{statusLabel[status]}</span>}
    </Fragment>
    <slot name="media" slot="media" />
    <slot />
</PageLayout>

<style>
    .kind {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
        color: var(--ink-soft);
        text-decoration: none;
    }
    .kind:hover,
    .kind:focus-visible {
        color: var(--link);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .status {
        font-style: italic;
    }
    @media (max-width: 760px) {
        .kind {
            margin-bottom: 0;
        }
        .status::before {
            content: "·";
            margin-right: 14px;
            font-style: normal;
        }
    }
</style>
